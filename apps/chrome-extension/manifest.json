{
  "manifest_version": 3,
  "name": "大家的日本语 — 新标签复习",
  "version": "1.0.0",
  "description": "每次开新标签，随机展示当前课词汇和语法卡片",
  "chrome_url_overrides": {
    "newtab": "newtab/index.html"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["vocabulary.json", "grammar.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
